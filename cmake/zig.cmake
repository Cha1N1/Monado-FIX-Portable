# Toolchain file: zig cc / zig c++ as the C and C++ compilers (the same compiler the shell scripts use).
# The zig executable comes from the ziglang package in the project's .venv (pip install ziglang), unless
# ZIG_EXECUTABLE names one. ZIG_TARGET (e.g. x86_64-windows-gnu) cross-compiles; empty builds for the host.
set(MONADO_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
set(ZIG_EXECUTABLE "${ZIG_EXECUTABLE}" CACHE FILEPATH "zig executable (default: the ziglang package of .venv)")
set(ZIG_TARGET "${ZIG_TARGET}" CACHE STRING "zig -target triple (empty: the host)")
if(NOT ZIG_EXECUTABLE)
  if(CMAKE_HOST_WIN32)
    set(_monado_py "${MONADO_ROOT}/.venv/Scripts/python.exe")
  else()
    set(_monado_py "${MONADO_ROOT}/.venv/bin/python")
  endif()
  execute_process(COMMAND "${_monado_py}" -c "import ziglang, os; print(os.path.dirname(ziglang.__file__))"
                  OUTPUT_VARIABLE _monado_zig_dir OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _monado_rc ERROR_QUIET)
  if(NOT _monado_rc EQUAL 0)
    message(FATAL_ERROR "zig not found: install it into the project venv (${_monado_py} -m pip install ziglang==0.13.0) "
                        "or pass -DZIG_EXECUTABLE=<path to zig>")
  endif()
  find_program(_monado_zig NAMES zig zig.exe HINTS "${_monado_zig_dir}" NO_DEFAULT_PATH REQUIRED)
  set(ZIG_EXECUTABLE "${_monado_zig}" CACHE FILEPATH "zig executable (default: the ziglang package of .venv)" FORCE)
endif()
set(CMAKE_C_COMPILER "${ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER "${ZIG_EXECUTABLE}")
if(ZIG_TARGET)
  set(CMAKE_C_COMPILER_ARG1 "cc -target ${ZIG_TARGET}")
  set(CMAKE_CXX_COMPILER_ARG1 "c++ -target ${ZIG_TARGET}")
  if(ZIG_TARGET MATCHES "windows")
    set(CMAKE_SYSTEM_NAME Windows)
  elseif(ZIG_TARGET MATCHES "linux")
    set(CMAKE_SYSTEM_NAME Linux)
  endif()
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
else()
  set(CMAKE_C_COMPILER_ARG1 cc)
  set(CMAKE_CXX_COMPILER_ARG1 c++)
endif()
set(MONADO_ZIG ON)
# (the compiler checks re-read this file in their own projects)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZIG_EXECUTABLE ZIG_TARGET)
